<% count = local_assigns.fetch(:count, 6) %>
<% card_class = local_assigns.fetch(:card_class, "w-full flex flex-col gap-4 rounded-lg overflow-hidden shadow-md h-32 bg-white p-4") %>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4" aria-busy="true" aria-live="polite">
  <% count.times do %>
    <div class="<%= card_class %>">
      <div class="flex flex-col gap-2">
        <div class="h-6 w-3/4 rounded-md bg-slate-200"></div>
        <div class="h-5 w-1/2 rounded-md bg-slate-200"></div>
        <div class="h-4 w-1/3 rounded-md bg-slate-200"></div>
      </div>
      <div class="w-full flex justify-end">
        <span class="flex items-center justify-center h-7 w-7 rounded-full bg-slate-200"></span>
      </div>
    </div>
  <% end %>
</div>
